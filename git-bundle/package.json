{
  "name": "@missher/dsh-media-missher",
  "version": "17.0.1",
  "description": "Private Media@Missher collection Bundle for DeepSeek Harness",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.1.3",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "payload",
    "cordis.patch.yml",
    "README.md",
    "DATA_CAPABILITIES.md",
    "QUICKSTART.md",
    "AGENT_INSTALL.md",
    "AGENT.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "stage:payload": "node scripts/stage-payload.mjs",
    "test": "vitest run",
    "prepack": "pnpm run build && pnpm run stage:payload",
    "pack:bundle": "node -e \"require('node:fs').mkdirSync('dist', { recursive: true })\" && pnpm pack --pack-destination dist",
    "verify:package": "node scripts/verify-package.mjs",
    "smoke:native": "node scripts/native-smoke.mjs",
    "smoke:browser": "node scripts/browser-native-smoke.mjs",
    "setup:device": "node scripts/setup-device.mjs"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "saxes": "5.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "author": "Missher"
}
