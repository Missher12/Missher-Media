{
  "name": "dsh-media-missher",
  "version": "0.1.0",
  "description": "Private Media@Missher collection Bundle for DeepSeek Harness",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.1.3",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "payload",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "stage:payload": "node scripts/stage-payload.mjs",
    "test": "vitest run",
    "prepack": "pnpm run build && pnpm run stage:payload",
    "pack:bundle": "pnpm pack --pack-destination dist",
    "verify:package": "node scripts/verify-package.mjs",
    "smoke:native": "node scripts/native-smoke.mjs"
  },
  "dependencies": {
    "exceljs": "4.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@types/node": "^25.0.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
